# 서버
PORT=4001
NODE_ENV=development

# 데이터베이스
MONGODB_URI=mongodb://localhost:27017/json-mock-hub
REDIS_URL=redis://localhost:6379

# JWT (반드시 안전한 랜덤 값으로 교체)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/auth/google/callback

# 프론트 / CORS
CLIENT_URL=http://localhost:4000
CORS_ORIGIN_URL=http://localhost:4000

# Mock 서빙 베이스 도메인
MOCK_BASE_DOMAIN=localhost:4001

# 알림 (선택)
DISCORD_WEBHOOK_URL=

# 웹과 API가 서로 다른 사이트(eTLD+1)에 배포되면 true (이 프로젝트의 프로덕션 구성).
# true면 인증 쿠키가 SameSite=None이 되어 브라우저의 CSRF 기본 방어가 꺼지므로,
# CsrfHeaderGuard의 X-Requested-With 헤더 요구가 유일한 CSRF 방어선이 된다.
# 같은 사이트(app.example.com / api.example.com)로 옮기면 false로 두어 lax를 더한다.
CROSS_SITE_COOKIES=true
