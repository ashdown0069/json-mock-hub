# 서버
# - 로컬 개발: PORT=4001, NODE_ENV=development
# - 배포 환경: PORT=3000 (컨테이너 포트), NODE_ENV=production
PORT=4001
NODE_ENV=development

# 데이터베이스
MONGODB_URI=mongodb://localhost:27017/json-mock-hub
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# 프론트엔드 URL / CORS 허용 Origin
# - 로컬 개발: http://localhost:4000
# - 배포 환경: https://app.myrealm.cloud
CLIENT_URL=http://localhost:4000 # 구글로그인용 - 현재사용안함
CORS_ORIGIN_URL=http://localhost:4000

# Mock 서빙 베이스 도메인 (Host 헤더에서 workspaceId 서브도메인을 파싱하는 기준값)
# - 로컬 개발: localhost:4001 (포트 포함 필수)
# - 배포 환경: myrealm.cloud (포트 없음, {workspaceId}.myrealm.cloud/api/...)
MOCK_BASE_DOMAIN=localhost:4001

# 서브도메인 간 인증 쿠키 공유 도메인 (Set-Cookie의 Domain 속성)
# - 로컬 개발: 비워둠 (localhost 환경에서는 domain 속성을 주면 브라우저가 쿠키 거부)
# - 배포 환경: .myrealm.cloud (app.myrealm.cloud ↔ api.myrealm.cloud 간 쿠키 공유)
COOKIE_DOMAIN=

# 크로스 사이트 쿠키 허용 여부 (SameSite=None 설정)
# - 로컬 개발: false (동일 localhost 환경이므로 lax 사용)
# - 배포 환경: true (app.myrealm.cloud ↔ api.myrealm.cloud 간 크로스 오리진 전송 보장)
CROSS_SITE_COOKIES=true
