{
  "name": "@workspace/types",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest && npm run verify:runtime",
    "verify:runtime": "node scripts/smoke.cjs && node scripts/smoke.mjs"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "moduleResolution": "node",
            "esModuleInterop": true
          }
        }
      ]
    }
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "^20.3.1",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "5.9.3"
  }
}
